		\item ในบริบทเดียวกันกับข้อ 2 แต่คราวนี้อยากให้ทำ \texttt{FindLast(arr,x)} กล่าวคือค้นหา index สุดท้ายที่ \texttt{x} ปรากฏใน \texttt{arr} เช่น \texttt{FindLast($[1,-5,0,3,-5]$,$-5$)} ต้องได้ $4$
		
		(หมายเหตุ: กันคนหัวหมอ - ห้าม reverse แล้วใช้ \texttt{FindFirst})
		
		\begin{ansbox}
			\begin{algorithm}[H]
					\caption{FindLast(arr,x): FindLast แบบ recursion}
					\begin{algorithmic}[1]
						\Require อารเรย์ของจำนวนเต็ม arr และจำนวนเต็ม x
						\If{len(arr) == 0}
						\State\Return -1
						\Else
						\State induct\_result = FindLast(arr[0..(len(arr)-2)], x)
						\If{x == arr[len(arr)-1]}
						\State\Return len(arr)-1
						\ElsIf{induct\_result == -1}
						\State\Return -1
						\Else
						\State\Return induct\_result
						\EndIf
						\EndIf
					\end{algorithmic}
			\end{algorithm}
		\end{ansbox}
		
