			\textbf{แนวคิด}: $n! = 1\times 2 \times 3 \times \cdots \times (n-1) \times n = (1\times 2 \times 3 \times \cdots \times (n-1)) \times n = (n-1)! \times n$
			
			ดังนั้น เราจึงสามารถเขียนนิยาม factorial ในรูปแบบ recursion ได้เป็น $Fac(n) = F(n-1)\times n$ โดยที่ $Fac(0) = 1$
			
			\textbf{หมายเหตุ}: สาเหตุที่ทำให้เราต้องนิยาม $Fac(0) = 1$ เพราะเราต้องการใช้ $1 = Fac(1) = Fac(0) \times 1$
			
			\begin{algorithm}[H]
				\caption{Factorial แบบ iteration}
				\begin{algorithmic}[1]
					\Require จำนวนนับ $n\geq 0$
					
					\State $fac = 1$ \Comment{$fac(0) = 1$}
					\For{$i=1..n$}
					\State $fac = fac\times i$
					\EndFor
					\State\Return $fac$

				\end{algorithmic}
			\end{algorithm}
			
			\begin{algorithm}[H]
				\caption{$fac(n)$: Factorial แบบ recursion}
				\begin{algorithmic}[1]
					\Require จำนวนนับ $n\geq 0$
					\If{$n==0$}
						\State\Return $1$ \Comment{$fac(0) = 1$}
					\Else
						\State\Return $fac(n-1) \times n$
					\EndIf
				\end{algorithmic}
			\end{algorithm}
			
