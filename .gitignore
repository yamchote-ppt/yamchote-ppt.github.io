# NOTE: tex/sty/cls/bib source files are excluded only under assets/latex/
# via assets/latex/.gitignore — not globally, to allow other .tex files in the repo.

# LaTeX support files
*.tikz
*.ist
*.glo
*.glsdefs
*.acn
*.acr
*.alg
*.idx
*.ilg
*.ind

# NOTE: image/font/csv rules are intentionally scoped to assets/latex/.gitignore
# to avoid excluding website assets (images, fonts) at the root level.

# Keep PDF files (this line ensures PDFs are tracked)
!*.pdf

# Other common excludes
node_modules/
.vscode/
.idea/
*.tmp
